# Threadmap client configuration. Copy to .env.local for local development.
# Public Firebase web values identify the project; they are not service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_THREADMAP_PRIVATE_MODE=true
THREADMAP_DEPLOYMENT_MODE=private

# Browser push notifications. The Firebase VAPID key is used by FCM.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_WEBPUSH_VAPID_KEY=

# Google Calendar OAuth client ID.
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=

# Google Custom Search API for wishlist image/price search endpoints.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Server-only shared quota secret. Configure the same random value in Vercel
# and as the Firebase Functions secret SCRAPE_RATE_LIMIT_SHARED_SECRET.
SCRAPE_RATE_LIMIT_SHARED_SECRET=

# Configure these as Firebase Functions secrets, not public Vercel variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production trust and legal identity. Private single-user deployments require
# working contact mailboxes but do not publish an operator name or postal address.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
LEGAL_CONTACT_EMAIL=
SECURITY_CONTACT_EMAIL=
# Required only when THREADMAP_DEPLOYMENT_MODE=public.
LEGAL_ENTITY_NAME=
LEGAL_POSTAL_ADDRESS=
