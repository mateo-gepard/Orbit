# Firebase client config. Required for cloud sign-in and Firestore sync.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Browser push notifications. The Firebase VAPID key is used by FCM.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_WEBPUSH_VAPID_KEY=

# Google Calendar OAuth client ID.
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=

# Google Custom Search API for wishlist image/price search endpoints.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Cloud Functions secrets for native Web Push.
# In production, set these with Firebase secrets rather than committing them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
