rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
          && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid));
    }

    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownerPrefixed(docId) {
      return signedIn()
          && docId.size() > request.auth.uid.size()
          && docId[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
    }

    function validItem(data) {
      return data.userId is string
          && data.title is string
          && data.title.size() <= 500
          && data.type in ['task', 'project', 'habit', 'event', 'goal', 'note']
          && data.status in ['active', 'waiting', 'done', 'archived']
          && data.createdAt is int
          && data.updatedAt is int
          && data.revision is int
          && data.revision >= 1
          && (!('content' in data) || (data.content is string && data.content.size() <= 200000))
          && (!('linkedIds' in data) || (data.linkedIds is list && data.linkedIds.size() <= 500))
          && (!('tags' in data) || (data.tags is list && data.tags.size() <= 100))
          && (!('files' in data) || (data.files is list && data.files.size() <= 50));
    }

    function existingFilesPreserved(before, after) {
      return !('files' in before)
          || (('files' in after) && after.files is list && after.files.hasAll(before.files));
    }

    function parentTypeAllowed(childType, parentType) {
      return (childType == 'goal' && parentType == 'project')
          || (childType in ['task', 'event', 'note', 'habit']
              && parentType in ['project', 'goal']);
    }

    function validParentReference(itemId, data) {
      return !('parentId' in data)
          || (data.parentId is string
              && data.parentId != itemId
              && exists(/databases/$(database)/documents/items/$(data.parentId))
              && get(/databases/$(database)/documents/items/$(data.parentId)).data.userId == request.auth.uid
              && get(/databases/$(database)/documents/items/$(data.parentId)).data.status != 'archived'
              && parentTypeAllowed(
                data.type,
                get(/databases/$(database)/documents/items/$(data.parentId)).data.type
              ));
    }

    function validToolMetadata(docId, data, toolId) {
      let uid = request.auth.uid;
      return docId == uid + '_' + toolId
          && data.userId == uid
          && data.toolId == toolId
          && data.updatedAt is int
          && data.updatedAt > 0
          && data.revision is int
          && data.revision > 0;
    }

    function validToolDocument(docId, data) {
      return (validToolMetadata(docId, data, 'abitur')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'profile'])
                && data.profile is map)
          || (validToolMetadata(docId, data, 'toolbox')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'enabledTools'])
                && data.enabledTools is list
                && data.enabledTools.size() <= 20)
          || (validToolMetadata(docId, data, 'wishlist')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'items', 'duels'])
                && data.items is list
                && data.items.size() <= 500
                && data.duels is list
                && data.duels.size() <= 2000)
          || (validToolMetadata(docId, data, 'settings')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'settings'])
                && data.settings is map)
          || (validToolMetadata(docId, data, 'briefing-journal')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'version', 'dailyRecords', 'weeklyRecords'])
                && data.version == 2
                && data.dailyRecords is list
                && data.dailyRecords.size() <= 90
                && data.weeklyRecords is list
                && data.weeklyRecords.size() <= 26)
          || (validToolMetadata(docId, data, 'dispatch-plans')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'version', 'plans'])
                && data.version == 2
                && data.plans is list
                && data.plans.size() <= 31)
          || (validToolMetadata(docId, data, 'flightLogs')
                && data.keys().hasOnly(['userId', 'toolId', 'updatedAt', 'revision', 'logs'])
                && data.logs is list
                && data.logs.size() <= 100);
    }

    match /items/{itemId} {
      allow read: if signedIn() && owner(resource.data.userId);
      allow create: if signedIn()
                    && owner(request.resource.data.userId)
                    && validParentReference(itemId, request.resource.data)
                    && validItem(request.resource.data);
      allow update: if signedIn()
                    && owner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.revision == resource.data.get('revision', 0) + 1
                    && validParentReference(itemId, request.resource.data)
                    && existingFilesPreserved(resource.data, request.resource.data)
                    && validItem(request.resource.data);
      // Deletion is server-orchestrated so attachment cleanup and relationship
      // repair cannot be bypassed by a direct SDK call.
      allow delete: if false;
    }

    match /analytics/{eventId} {
      // Historical records remain available through the server-orchestrated
      // account export/delete workflow. New client telemetry is disabled.
      allow read, write: if false;
    }

    match /userSettings/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId)
                    && request.resource.data.keys().hasOnly([
                      'customTags', 'removedDefaultTags', 'updatedAt', 'revision'
                    ])
                    && request.resource.data.customTags is list
                    && request.resource.data.customTags.size() <= 100
                    && request.resource.data.removedDefaultTags is list
                    && request.resource.data.removedDefaultTags.size() <= 100
                    && request.resource.data.updatedAt is int
                    && request.resource.data.revision == 1;
      allow update: if owner(userId)
                    && request.resource.data.keys().hasOnly([
                      'customTags', 'removedDefaultTags', 'updatedAt', 'revision'
                    ])
                    && request.resource.data.customTags is list
                    && request.resource.data.customTags.size() <= 100
                    && request.resource.data.removedDefaultTags is list
                    && request.resource.data.removedDefaultTags.size() <= 100
                    && request.resource.data.updatedAt is int
                    && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if owner(userId);
    }

    match /toolData/{docId} {
      allow read: if signedIn()
                  && ownerPrefixed(docId)
                  && (resource == null
                      || owner(resource.data.userId)
                      || (docId == request.auth.uid + '_flightLogs'
                          && !('userId' in resource.data)));
      allow create: if signedIn()
                    && ownerPrefixed(docId)
                    && owner(request.resource.data.userId)
                    && validToolDocument(docId, request.resource.data)
                    && request.resource.data.revision == 1;
      allow update: if signedIn()
                    && ownerPrefixed(docId)
                    && owner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && validToolDocument(docId, request.resource.data)
                    && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if signedIn()
                    && ownerPrefixed(docId)
                    && (owner(resource.data.userId)
                        || (docId == request.auth.uid + '_flightLogs'
                            && !('userId' in resource.data)));
    }

    match /fcmTokens/{docId} {
      allow get: if signedIn()
                 && ownerPrefixed(docId)
                 && (resource == null || owner(resource.data.userId));
      // Collection queries must constrain userId to the authenticated UID;
      // Firestore can prove that predicate, unlike a document-ID prefix.
      allow list: if signedIn() && owner(resource.data.userId);
      // Credential, schedule, and quota mutations are validated and serialized
      // by authenticated Cloud Functions.
      allow create, update, delete: if false;
    }

    match /flightLogs/{docId} {
      allow get: if signedIn()
                 && ownerPrefixed(docId)
                 && (resource == null || owner(resource.data.userId));
      allow list: if signedIn() && owner(resource.data.userId);
      allow create: if signedIn()
                    && ownerPrefixed(docId)
                    && owner(request.resource.data.userId)
                    && request.resource.data.id is string
                    && request.resource.data.startedAt is int;
      allow update: if signedIn()
                    && ownerPrefixed(docId)
                    && owner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.id == resource.data.id;
      allow delete: if signedIn() && ownerPrefixed(docId) && owner(resource.data.userId);
    }

    // The removed Circles feature retains its historical data but exposes no
    // browser access. Account deletion uses the Admin SDK and bypasses rules.
    match /users/{userId} {
      allow read, write: if false;
    }
    match /connections/{connectionId} {
      allow read, write: if false;
    }
    match /nudges/{nudgeId} {
      allow read, write: if false;
    }

    // Internal deletion tombstones are Cloud Functions-only.
    match /deletionJobs/{jobId} {
      allow read, write: if false;
    }

    match /accountDeletionJobs/{userId} {
      allow read, write: if false;
    }

    match /pushDeviceRegistries/{userId} {
      allow read, write: if false;
    }

    match /scrapeRateLimits/{quotaId} {
      allow read, write: if false;
    }

    match /attachmentUploadIntents/{intentId} {
      allow read, write: if false;
    }

    match /attachmentUploadRegistries/{registryId} {
      allow read, write: if false;
    }

    // MCP integration state is written exclusively by the authenticated Cloud
    // Function, which uses the Admin SDK and bypasses these rules. Browser access
    // is denied on purpose: an access token, refresh token, or authorization code
    // must never be readable by a signed-in client, and quota and audit records
    // must not be forgeable. These blocks are redundant with the catch-all below
    // and exist so the intent is explicit rather than inferred.
    match /mcpOAuthClients/{clientId} { allow read, write: if false; }
    match /mcpOAuthAuthorizationRequests/{requestHash} { allow read, write: if false; }
    match /mcpOAuthAuthorizationCodes/{codeHash} { allow read, write: if false; }
    match /mcpOAuthAccessTokens/{tokenHash} { allow read, write: if false; }
    match /mcpOAuthRefreshTokens/{tokenHash} { allow read, write: if false; }
    match /mcpOAuthTokenFamilies/{familyId} { allow read, write: if false; }
    match /mcpIdempotency/{recordId} { allow read, write: if false; }
    match /mcpDeleteConfirmations/{tokenHash} { allow read, write: if false; }
    match /mcpRateLimits/{quotaId} { allow read, write: if false; }
    match /mcpAuditLogs/{auditId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
