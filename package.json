{
  "name": "threadmap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": "22.x",
    "npm": "11.5.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:licenses": "node scripts/check-licenses.mjs .",
    "audit:regions": "node scripts/check-deployment-regions.mjs",
    "release:contract": "npm run test:release-policy && node scripts/check-production-readiness.mjs --contract",
    "test:release-policy": "node --test scripts/*.test.mjs",
    "test": "vitest run && node scripts/report-rules-coverage.mjs",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-threadmap-rules-test --only firestore,storage \"vitest run src/test/firebase-rules.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "release:check": "node scripts/check-production-readiness.mjs",
    "release:read-sha": "node scripts/read-release-sha.mjs",
    "release:verify": "node scripts/verify-release-target.mjs",
    "release:verify:vercel-link": "node scripts/verify-vercel-project-link.mjs",
    "deploy:rules": "npm run deploy:rules:staging",
    "deploy:functions": "npm run deploy:functions:staging",
    "deploy:rules:staging": "firebase deploy --project threadmap-staging-9e0b6 --only firestore:rules,firestore:indexes,storage",
    "deploy:functions:staging": "firebase deploy --project threadmap-staging-9e0b6 --only functions",
    "deploy:firebase:staging": "firebase deploy --project threadmap-staging-9e0b6 --only functions,firestore:rules,firestore:indexes,storage",
    "deploy:rules:production": "node scripts/guarded-firebase-deploy.mjs --project orbit-9e0b6 --only firestore:rules,firestore:indexes,storage",
    "deploy:functions:production": "node scripts/guarded-firebase-deploy.mjs --project orbit-9e0b6 --only functions",
    "deploy:firebase:production": "node scripts/guarded-firebase-deploy.mjs --project orbit-9e0b6 --only functions,firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.9.0",
    "lucide-react": "^0.563.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.1",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^8.10.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.11.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.26.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
