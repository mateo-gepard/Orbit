{
  "name": "threadmap-functions",
  "description": "Threadmap Cloud Functions — scheduled briefing push notifications",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "migrate:legacy-files": "npm run build && node lib/migrate-legacy-storage.js",
    "migrate:revisions": "npm run build && node lib/migrate-revisions.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
