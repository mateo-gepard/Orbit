# Non-secret Cloud Functions deployment configuration.
# Store VAPID_PRIVATE_KEY and SCRAPE_RATE_LIMIT_SHARED_SECRET in Secret Manager.

# Enable only after the deployed web client is producing verified App Check traffic.
ENFORCE_APP_CHECK=false

MCP_ORIGIN=https://threadmap.app
MCP_DISCOVERY_ORIGIN=https://threadmap.app
MCP_CONSENT_ORIGIN=https://threadmap.app
MCP_ALLOW_LOOPBACK_REDIRECTS=false
MCP_DYNAMIC_CLIENT_SCOPES=items.read,items.write,items.delete,offline_access
