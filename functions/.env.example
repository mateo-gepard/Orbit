# Non-secret Cloud Functions deployment configuration.
# Store every secret named at the bottom in Secret Manager.

# Enable only after the deployed web client is producing verified App Check traffic.
ENFORCE_APP_CHECK=false

MCP_ORIGIN=https://staging.threadmap.app
MCP_ALLOW_LOOPBACK_REDIRECTS=false
MCP_DYNAMIC_CLIENT_SCOPES=threadmap.read offline_access
# MCP_EXTRA_REDIRECT_URIS=https://approved-client.example/oauth/callback

# Intended staging values. The HTTPS origin/DNS must exist and be verified
# before staging evidence can unblock production release.
THREADMAP_APP_ORIGIN=https://staging.threadmap.app
AUTH_EMAIL_FIREBASE_ACTION_HOSTS=threadmap-staging-9e0b6.firebaseapp.com,threadmap-staging-9e0b6.web.app

# Store these in Secret Manager; do not add secret values to this file.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# SCRAPE_RATE_LIMIT_SHARED_SECRET=
# MFA_RECOVERY_HMAC_KEY=
# RESEND_API_KEY=
# AUTH_EMAIL_HMAC_KEY=
